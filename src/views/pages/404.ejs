<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="py-5 text-center my-auto">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card border rounded-4 shadow-sm p-5 bg-white">
          <div class="brand-icon mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.2rem; background: linear-gradient(135deg, #ef4444, #dc2626);">
            <i class="bi bi-emoji-frown"></i>
          </div>
          <h1 class="display-4 fw-bold text-dark mb-2">404</h1>
          <h3 class="fw-bold mb-3"><%= typeof message !== 'undefined' ? message : 'Oops! Page Not Found' %></h3>
          <p class="text-muted mb-4">
            The meal or page you were looking for seems to have been eaten or never existed. Let's get you back on track!
          </p>
          <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-primary-custom">
              <i class="bi bi-house me-1"></i> Back to Home
            </a>
            <a href="/menu" class="btn btn-secondary-custom">
              <i class="bi bi-grid me-1"></i> Browse Menu
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
