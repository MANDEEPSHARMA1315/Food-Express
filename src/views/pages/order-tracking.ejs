<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="py-5">
  <div class="container">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
      <div>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="/orders">Orders</a></li>
            <li class="breadcrumb-item active" aria-current="page">Track #<%= order.id %></li>
          </ol>
        </nav>
        <h1 class="h2 fw-bold mb-0">Track Order #<%= order.id %></h1>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">
          <i class="bi bi-clock-history me-1"></i> ETA: <%= order.estimatedDelivery %>
        </span>
      </div>
    </div>

    <!-- Stepper Card -->
    <div class="card border rounded-4 shadow-sm p-4 p-md-5 mb-4">
      <div class="text-center mb-4">
        <h3 class="fw-bold text-dark">Order Status: <span class="text-danger"><%= order.status %></span></h3>
        <p class="text-muted">Live real-time delivery pipeline tracking</p>
      </div>

      <!-- Milestone Stepper Bar -->
      <div class="stepper-wrapper">
        <div class="stepper-line"></div>
        <div class="stepper-progress" style="width: <%= (order.statusStep - 1) * 25 %>%;"></div>

        <% steps.forEach(stepObj => { %>
          <% 
            const isCompleted = stepObj.step < order.statusStep;
            const isActive = stepObj.step === order.statusStep;
          %>
          <div class="step-node <%= isCompleted ? 'completed' : '' %> <%= isActive ? 'active' : '' %>">
            <div class="step-icon-circle">
              <i class="bi <%= isCompleted ? 'bi-check-lg' : stepObj.icon %>"></i>
            </div>
            <span class="step-title <%= isActive ? 'text-danger' : (isCompleted ? 'text-dark' : 'text-muted') %>">
              <%= stepObj.title %>
            </span>
            <small class="step-desc d-none d-md-block"><%= stepObj.desc %></small>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="row g-4">
      <!-- Rider & Delivery Info -->
      <div class="col-lg-6">
        <div class="card border rounded-4 shadow-sm p-4 h-100">
          <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-bicycle text-danger fs-4"></i> Delivery Partner Assigned
          </h5>

          <% if (order.rider) { %>
            <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 mb-3">
              <div class="d-flex align-items-center gap-3">
                <div class="brand-icon" style="width: 50px; height: 50px; background: #0f172a;">
                  <i class="bi bi-person"></i>
                </div>
                <div>
                  <h6 class="fw-bold mb-0"><%= order.rider.name %></h6>
                  <small class="text-muted"><%= order.rider.vehicle %></small>
                </div>
              </div>
              <a href="tel:<%= order.rider.phone %>" class="btn btn-outline-success rounded-pill px-3 py-1 btn-sm">
                <i class="bi bi-telephone-fill me-1"></i> Call Rider
              </a>
            </div>
          <% } %>

          <h6 class="fw-bold mb-2 small text-uppercase text-muted">Delivery Address</h6>
          <p class="text-dark bg-light p-3 rounded-3 mb-3 small">
            <i class="bi bi-geo-alt-fill text-danger me-1"></i> <%= order.deliveryAddress %>
          </p>

          <h6 class="fw-bold mb-2 small text-uppercase text-muted">Estimated Arrival</h6>
          <div class="p-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3">
            <strong class="text-danger d-block fs-5"><%= order.estimatedDelivery %></strong>
            <small class="text-muted">Food has been securely packed with hygiene seals.</small>
          </div>
        </div>
      </div>

      <!-- Order Receipt Summary -->
      <div class="col-lg-6">
        <div class="card border rounded-4 shadow-sm p-4 h-100">
          <h5 class="fw-bold mb-3">Order Receipt Details</h5>

          <div class="d-flex flex-column gap-2 mb-3">
            <% order.items.forEach(item => { %>
              <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div>
                  <span class="badge bg-secondary-subtle text-dark me-2"><%= item.qty %>x</span>
                  <span class="fw-semibold text-dark"><%= item.name %></span>
                </div>
                <strong class="text-dark">₹<%= item.price * item.qty %></strong>
              </div>
            <% }) %>
          </div>

          <div class="d-flex justify-content-between small text-muted mb-1">
            <span>Item Subtotal</span>
            <span>₹<%= order.subtotal %></span>
          </div>
          <div class="d-flex justify-content-between small text-muted mb-1">
            <span>Delivery Fee</span>
            <span>₹<%= order.deliveryFee %></span>
          </div>
          <div class="d-flex justify-content-between small text-muted mb-1">
            <span>Taxes & GST</span>
            <span>₹<%= order.tax %></span>
          </div>
          <% if (order.discount > 0) { %>
            <div class="d-flex justify-content-between small text-success mb-2">
              <span>Promo Discount</span>
              <span>-₹<%= order.discount %></span>
            </div>
          <% } %>

          <hr class="my-2">

          <div class="d-flex justify-content-between align-items-center mt-2">
            <strong class="fs-5">Total Paid:</strong>
            <strong class="fs-4 text-danger">₹<%= order.total %></strong>
          </div>
          <small class="text-muted d-block mt-1">Payment Method: <%= order.paymentMethod %></small>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
