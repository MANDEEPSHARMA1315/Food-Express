<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="py-5">
  <div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/menu">Menu</a></li>
        <li class="breadcrumb-item"><a href="/menu?category=<%= food.categorySlug %>"><%= food.category %></a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= food.name %></li>
      </ol>
    </nav>

    <div class="row g-5 align-items-center mb-5">
      <!-- Food Image Showcase -->
      <div class="col-lg-6">
        <div class="position-relative rounded-4 overflow-hidden shadow-lg border">
          <img src="<%= food.image %>" alt="<%= food.name %>" class="img-fluid w-100" style="max-height: 460px; object-fit: cover;">
          <div class="position-absolute top-0 end-0 m-3">
            <span class="badge bg-dark bg-opacity-75 px-3 py-2 rounded-pill fs-6">
              <i class="bi bi-star-fill text-warning me-1"></i> <%= food.rating %> (<%= food.reviewsCount %> ratings)
            </span>
          </div>
        </div>
      </div>

      <!-- Food Info & Actions -->
      <div class="col-lg-6">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge-diet <%= food.isVeg ? 'badge-veg' : 'badge-non-veg' %>">
            <% if (food.isVeg) { %>
              <span class="badge-veg-circle"></span>
            <% } else { %>
              <span class="badge-non-veg-triangle"></span>
            <% } %>
          </span>
          <span class="badge bg-light text-dark border"><%= food.category %></span>
          <% if (food.isPopular) { %>
            <span class="badge bg-warning text-dark"><i class="bi bi-fire"></i> Best Seller</span>
          <% } %>
        </div>

        <h1 class="display-6 fw-bold mb-3"><%= food.name %></h1>

        <div class="d-flex align-items-baseline gap-3 mb-4">
          <span class="display-6 fw-bold text-danger">₹<%= food.price %></span>
          <% if (food.originalPrice) { %>
            <span class="fs-4 text-muted text-decoration-line-through">₹<%= food.originalPrice %></span>
            <span class="badge bg-success-subtle text-success fw-bold px-2 py-1 rounded">
              <%= Math.round(((food.originalPrice - food.price) / food.originalPrice) * 100) %>% OFF
            </span>
          <% } %>
        </div>

        <p class="text-secondary fs-5 mb-4">
          <%= food.description %>
        </p>

        <!-- Highlights & Specs -->
        <div class="row g-3 mb-4 p-3 bg-white rounded-3 border">
          <div class="col-4 text-center border-end">
            <i class="bi bi-clock-history text-primary fs-4 d-block mb-1"></i>
            <small class="text-muted d-block">Delivery Time</small>
            <strong class="text-dark"><%= food.deliveryTime %></strong>
          </div>
          <div class="col-4 text-center border-end">
            <i class="bi bi-fire text-danger fs-4 d-block mb-1"></i>
            <small class="text-muted d-block">Calories</small>
            <strong class="text-dark"><%= food.calories %></strong>
          </div>
          <div class="col-4 text-center">
            <i class="bi bi-shield-check text-success fs-4 d-block mb-1"></i>
            <small class="text-muted d-block">Packaging</small>
            <strong class="text-dark">Tamper-Proof</strong>
          </div>
        </div>

        <!-- Add to Cart CTA -->
        <div class="d-flex align-items-center gap-3">
          <div class="qty-control px-2 py-1 border bg-white">
            <button class="qty-btn" type="button" onclick="const input = document.getElementById('detailsQty'); if(input.value > 1) input.value--;">-</button>
            <input type="text" id="detailsQty" class="qty-input" value="1" readonly>
            <button class="qty-btn" type="button" onclick="const input = document.getElementById('detailsQty'); input.value++;">+</button>
          </div>

          <a href="/cart" class="btn btn-primary-custom flex-grow-1 justify-content-center py-3 fs-5" id="detailsAddToCartBtn">
            <i class="bi bi-bag-plus"></i> Add to Order • ₹<%= food.price %>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Dishes -->
    <% if (relatedFoods && relatedFoods.length > 0) { %>
      <div class="pt-5 border-top">
        <h3 class="fw-bold mb-4">You Might Also Love</h3>
        <div class="row g-4">
          <% relatedFoods.forEach(rel => { %>
            <div class="col-md-4">
              <div class="card h-100 border rounded-4 overflow-hidden shadow-sm">
                <img src="<%= rel.image %>" alt="<%= rel.name %>" class="card-img-top" style="height: 180px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small text-muted"><%= rel.category %></span>
                    <span class="fw-bold text-dark">₹<%= rel.price %></span>
                  </div>
                  <h5 class="fw-bold fs-6 mb-2"><a href="/food/<%= rel.id %>" class="text-dark text-decoration-none"><%= rel.name %></a></h5>
                  <p class="small text-muted mb-3 flex-grow-1"><%= rel.description.substring(0, 75) %>...</p>
                  <a href="/food/<%= rel.id %>" class="btn btn-sm btn-outline-danger rounded-pill w-100">View Dish</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
