<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="py-5">
  <div class="container">
    <div class="mb-4">
      <h1 class="h2 fw-bold mb-1">Shopping Cart</h1>
      <p class="text-muted mb-0">Review your selected meals before checking out.</p>
    </div>

    <div class="row g-4" id="cartTableContainer">
      <!-- Cart Items Table -->
      <div class="col-lg-8">
        <div class="card border rounded-4 shadow-sm overflow-hidden mb-3">
          <div class="table-responsive">
            <table class="table cart-table align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" style="min-width: 250px;">Dish</th>
                  <th scope="col">Price</th>
                  <th scope="col" class="text-center">Quantity</th>
                  <th scope="col" class="text-end">Total</th>
                  <th scope="col" class="text-center">Action</th>
                </tr>
              </thead>
              <tbody>
                <% cartItems.forEach(item => { %>
                  <tr class="cart-row" data-food-id="<%= item.foodId %>" data-price="<%= item.price %>">
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <img src="<%= item.image %>" alt="<%= item.name %>" class="cart-item-img">
                        <div>
                          <div class="d-flex align-items-center gap-2">
                            <span class="badge-diet <%= item.isVeg ? 'badge-veg' : 'badge-non-veg' %>">
                              <% if (item.isVeg) { %>
                                <span class="badge-veg-circle"></span>
                              <% } else { %>
                                <span class="badge-non-veg-triangle"></span>
                              <% } %>
                            </span>
                            <h6 class="mb-0 fw-bold"><%= item.name %></h6>
                          </div>
                          <small class="text-muted">Freshly Prepared</small>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="fw-semibold text-dark">₹<%= item.price %></span>
                    </td>
                    <td class="text-center">
                      <div class="qty-control">
                        <button type="button" class="qty-btn qty-dec"><i class="bi bi-dash"></i></button>
                        <input type="text" class="qty-input" value="<%= item.quantity %>" readonly>
                        <button type="button" class="qty-btn qty-inc"><i class="bi bi-plus"></i></button>
                      </div>
                    </td>
                    <td class="text-end">
                      <strong class="text-dark row-total">₹<%= item.price * item.quantity %></strong>
                    </td>
                    <td class="text-center">
                      <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle btn-remove-item" title="Remove Item">
                        <i class="bi bi-trash3"></i>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center">
          <a href="/menu" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Continue Shopping
          </a>
        </div>
      </div>

      <!-- Order Summary Card -->
      <div class="col-lg-4">
        <div class="order-summary-card">
          <h4 class="fw-bold mb-3">Order Summary</h4>

          <!-- Free Delivery Progress / Notice -->
          <div class="p-3 bg-light rounded-3 mb-3" id="freeDeliveryNotice">
            <% if (summary.subtotal >= 499) { %>
              <span class="badge bg-success-subtle text-success"><i class="bi bi-patch-check-fill me-1"></i>You unlocked Free Delivery!</span>
            <% } else { %>
              <small class="text-muted">Add <strong class="text-primary">₹<%= 499 - summary.subtotal %></strong> more to get Free Delivery!</small>
            <% } %>
          </div>

          <!-- Coupon Code Input -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-muted">Have a Coupon?</label>
            <div class="input-group">
              <input type="text" id="couponCodeInput" class="form-control" placeholder="Try 'EXPRESS50'" aria-label="Coupon code">
              <button class="btn btn-outline-danger" type="button" id="btnApplyCoupon">Apply</button>
            </div>
            <div id="couponFeedback" class="small mt-1"></div>
          </div>

          <hr class="my-3">

          <!-- Price Line Items -->
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Item Subtotal</span>
            <span class="fw-semibold text-dark" id="summarySubtotal">₹<%= summary.subtotal %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Delivery Charges</span>
            <span class="fw-semibold text-dark" id="summaryDelivery">
              <% if (summary.deliveryFee === 0) { %>
                <span class="text-success fw-bold">FREE</span>
              <% } else { %>
                ₹<%= summary.deliveryFee %>
              <% } %>
            </span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">GST & Taxes (5%)</span>
            <span class="fw-semibold text-dark" id="summaryTax">₹<%= summary.tax %></span>
          </div>
          <div class="d-flex justify-content-between mb-3 text-success">
            <span>Discount Coupon</span>
            <span class="fw-semibold" id="summaryDiscount">-₹<%= summary.discount %></span>
          </div>

          <hr class="my-3">

          <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
              <span class="fw-bold fs-5 text-dark">To Pay</span>
              <small class="d-block text-muted">Inclusive of all taxes</small>
            </div>
            <span class="display-6 fw-bold text-danger" id="summaryTotal">₹<%= summary.total %></span>
          </div>

          <a href="/checkout" class="btn btn-primary-custom w-100 justify-content-center py-3 fs-5" id="proceedCheckoutBtn">
            Proceed to Checkout <i class="bi bi-arrow-right ms-2"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- Empty Cart Fallback -->
    <div id="emptyCartState" class="text-center py-5 bg-white rounded-4 border my-4" style="display: none;">
      <i class="bi bi-cart-x fs-1 text-muted d-block mb-3"></i>
      <h3 class="fw-bold">Your cart is empty</h3>
      <p class="text-muted">Looks like you haven't added anything to your cart yet.</p>
      <a href="/menu" class="btn btn-primary-custom mt-2">Explore Menu</a>
    </div>
  </div>
</main>

<!-- Load Cart Interactivity Script -->
<script src="/js/cart.js"></script>

<%- include('../partials/footer') %>
