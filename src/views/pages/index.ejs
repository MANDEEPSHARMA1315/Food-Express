<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="row align-items-center g-5">
        <!-- Hero Content -->
        <div class="col-lg-6">
          <div class="hero-pill">
            <i class="bi bi-lightning-charge-fill"></i> Fast 30-Minute Food Delivery
          </div>
          <h1 class="hero-title">
            Craving Good Food? <br>
            Delivered <span class="text-gradient">Hot & Fresh</span> In Minutes.
          </h1>
          <p class="hero-desc">
            Discover culinary delights from artisanal wood-fired pizzas to fragrant royal dum biryanis. Prepared with love by top chefs, delivered with lightning speed.
          </p>

          <div class="d-flex flex-wrap gap-3 mb-4">
            <a href="/menu" class="btn btn-primary-custom" id="heroOrderNowBtn">
              <i class="bi bi-cart3"></i> Order Food Now
            </a>
            <a href="#popularSection" class="btn btn-secondary-custom" id="heroExploreMenuBtn">
              <i class="bi bi-fire text-danger"></i> Popular Items
            </a>
          </div>

          <!-- Quick Trust Metrics -->
          <div class="row g-3 pt-3 border-top border-light-subtle">
            <div class="col-4">
              <h4 class="fw-bold mb-0 text-dark">30+ min</h4>
              <small class="text-muted">Average Delivery</small>
            </div>
            <div class="col-4">
              <h4 class="fw-bold mb-0 text-dark">4.9 ★</h4>
              <small class="text-muted">Customer Rating</small>
            </div>
            <div class="col-4">
              <h4 class="fw-bold mb-0 text-dark">500+</h4>
              <small class="text-muted">Gourmet Dishes</small>
            </div>
          </div>
        </div>

        <!-- Hero Visual Banner -->
        <div class="col-lg-6">
          <div class="hero-image-wrapper">
            <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=700&auto=format&fit=crop&q=80" alt="Delicious Burger" class="hero-main-img img-fluid">

            <!-- Floating Card 1: Review -->
            <div class="floating-card floating-card-1">
              <div class="bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="bi bi-star-fill"></i>
              </div>
              <div class="text-start">
                <div class="fw-bold text-dark small">Top Rated Food</div>
                <small class="text-muted">4.9 (2,400+ reviews)</small>
              </div>
            </div>

            <!-- Floating Card 2: ETA -->
            <div class="floating-card floating-card-2">
              <div class="bg-danger text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="bi bi-stopwatch-fill"></i>
              </div>
              <div class="text-start">
                <div class="fw-bold text-dark small">Super Fast Delivery</div>
                <small class="text-success fw-bold">Live GPS Tracking</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-5 bg-white border-bottom">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
          <span class="text-primary fw-bold small text-uppercase letter-spacing-1">What are you craving?</span>
          <h2 class="h3 fw-bold mb-0">Browse Popular Categories</h2>
        </div>
        <a href="/menu" class="btn btn-outline-secondary btn-sm rounded-pill px-3">View All Dishes <i class="bi bi-arrow-right ms-1"></i></a>
      </div>

      <div class="row g-3">
        <% categories.slice(1).forEach(cat => { %>
          <div class="col-lg-2 col-md-4 col-6">
            <a href="/menu?category=<%= cat.slug %>" class="category-card" id="catCard-<%= cat.slug %>">
              <div class="category-icon-wrapper">
                <i class="bi <%= cat.icon %>"></i>
              </div>
              <span class="category-name"><%= cat.name %></span>
              <span class="category-count"><%= cat.count %> delicious items</span>
            </a>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Popular Foods Section -->
  <section class="py-5" id="popularSection">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
          <span class="text-primary fw-bold small text-uppercase">Crowd Favorites</span>
          <h2 class="h3 fw-bold mb-0">Popular Dishes Right Now</h2>
        </div>
        <a href="/menu" class="btn btn-link text-primary fw-bold text-decoration-none">
          See Full Menu <i class="bi bi-arrow-right"></i>
        </a>
      </div>

      <div class="row g-4">
        <% popularFoods.forEach(food => { %>
          <div class="col-lg-4 col-md-6">
            <div class="food-card" id="foodCard-<%= food.id %>">
              <div class="food-img-container">
                <img src="<%= food.image %>" alt="<%= food.name %>" class="food-card-img" loading="lazy">
                <div class="food-badges-top">
                  <span class="badge-pill-blur">
                    <i class="bi bi-star-fill text-warning"></i> <%= food.rating %> (<%= food.reviewsCount %>)
                  </span>
                  <span class="badge-popular">
                    <i class="bi bi-fire"></i> Popular
                  </span>
                </div>
              </div>

              <div class="food-card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="text-muted small fw-medium"><%= food.category %></span>
                  <span class="badge-diet <%= food.isVeg ? 'badge-veg' : 'badge-non-veg' %>" title="<%= food.isVeg ? 'Vegetarian' : 'Non-Vegetarian' %>">
                    <% if (food.isVeg) { %>
                      <span class="badge-veg-circle"></span>
                    <% } else { %>
                      <span class="badge-non-veg-triangle"></span>
                    <% } %>
                  </span>
                </div>

                <h3 class="food-title">
                  <a href="/food/<%= food.id %>" class="text-dark text-decoration-none"><%= food.name %></a>
                </h3>
                <p class="food-desc"><%= food.description %></p>

                <div class="food-meta">
                  <span><i class="bi bi-clock me-1 text-primary"></i> <%= food.deliveryTime %></span>
                  <span>•</span>
                  <span><i class="bi bi-fire me-1 text-danger"></i> <%= food.calories %></span>
                </div>

                <div class="food-footer">
                  <div class="food-price">
                    ₹<%= food.price %>
                    <% if (food.originalPrice) { %>
                      <span class="original">₹<%= food.originalPrice %></span>
                    <% } %>
                  </div>
                  <div class="d-flex gap-2">
                    <a href="/food/<%= food.id %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="View Details">
                      Details
                    </a>
                    <button class="btn-add-cart" data-food-id="<%= food.id %>" data-food-name="<%= food.name %>" title="Add to Cart">
                      <i class="bi bi-plus-lg"></i>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Promo Discount Banner -->
  <section class="py-5">
    <div class="container">
      <div class="card border-0 rounded-4 overflow-hidden shadow-lg" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="card-body p-4 p-lg-5 text-white">
          <div class="row align-items-center g-4">
            <div class="col-lg-8">
              <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">SPECIAL OFFER</span>
              <h2 class="display-6 fw-bold mb-3 text-white">Get Flat ₹50 OFF On Your First Order</h2>
              <p class="text-secondary-subtle fs-5 mb-4">
                Use promo code <span class="text-warning fw-bold bg-dark px-2 py-1 rounded">EXPRESS50</span> at checkout. Free delivery included for orders above ₹499!
              </p>
              <div class="d-flex flex-wrap gap-3">
                <a href="/menu" class="btn btn-primary-custom">Claim Offer & Order Now</a>
                <a href="/register" class="btn btn-outline-light rounded-pill px-4">Create Free Account</a>
              </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
              <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=500&auto=format&fit=crop&q=80" alt="Discount Pizza" class="img-fluid rounded-4 shadow-lg" style="transform: rotate(3deg); max-height: 220px; object-fit: cover;">
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose FoodExpress (App Features) -->
  <section class="py-5 bg-white border-top">
    <div class="container">
      <div class="text-center max-w-600 mx-auto mb-5">
        <span class="text-primary fw-bold small text-uppercase">The FoodExpress Promise</span>
        <h2 class="h2 fw-bold">Why Customers Love Us</h2>
        <p class="text-muted">Built with industry standards for reliability, speed, and culinary excellence.</p>
      </div>

      <div class="row g-4 text-center">
        <div class="col-md-4">
          <div class="p-4 rounded-4 bg-light h-100 border">
            <div class="brand-icon mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.75rem;">
              <i class="bi bi-truck-front-fill"></i>
            </div>
            <h4 class="fw-bold mb-2">30-Min Fast Delivery</h4>
            <p class="text-muted mb-0">Our dedicated delivery fleet ensures your food reaches you piping hot, right on time every time.</p>
          </div>
        </div>

        <div class="col-md-4">
          <div class="p-4 rounded-4 bg-light h-100 border">
            <div class="brand-icon mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.75rem; background: linear-gradient(135deg, #10b981, #059669);">
              <i class="bi bi-shield-check"></i>
            </div>
            <h4 class="fw-bold mb-2">100% Quality & Hygiene</h4>
            <p class="text-muted mb-0">Prepared in certified sanitized kitchens using fresh, premium grade ingredients sourced daily.</p>
          </div>
        </div>

        <div class="col-md-4">
          <div class="p-4 rounded-4 bg-light h-100 border">
            <div class="brand-icon mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.75rem; background: linear-gradient(135deg, #0ea5e9, #0284c7);">
              <i class="bi bi-geo-alt-fill"></i>
            </div>
            <h4 class="fw-bold mb-2">Live Real-Time Tracking</h4>
            <p class="text-muted mb-0">Track your order at every milestone: from chef preparation to delivery rider at your doorstep.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
