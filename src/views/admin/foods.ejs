<%- include('../partials/head') %>

<!-- Admin Header -->
<nav class="navbar navbar-dark bg-dark px-3 py-2 border-bottom border-secondary">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/admin">
      <span class="badge bg-danger p-2"><i class="bi bi-shield-lock-fill"></i></span>
      <span>FoodExpress <span class="text-warning">Admin Console</span></span>
    </a>
    <div class="d-flex align-items-center gap-3">
      <a href="/" class="btn btn-outline-light btn-sm rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i> Visit Website</a>
      <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
    </div>
  </div>
</nav>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-lg-2 col-md-3 p-0 admin-sidebar">
      <div class="p-3">
        <h6 class="text-uppercase text-secondary-subtle small fw-bold mb-3">Management</h6>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/orders"><i class="bi bi-bag-check"></i> Customer Orders</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/admin/foods"><i class="bi bi-egg-fried"></i> Food Catalog</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/categories"><i class="bi bi-tags"></i> Food Categories</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="col-lg-10 col-md-9 p-4 bg-light">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h3 fw-bold mb-1">Food Inventory Catalog</h2>
          <p class="text-muted small mb-0">Create, edit, or remove menu items and configure pricing.</p>
        </div>
        <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addFoodModal">
          <i class="bi bi-plus-lg me-1"></i> Add Food Item
        </button>
      </div>

      <%- include('../partials/alerts') %>

      <div class="card border rounded-4 shadow-sm overflow-hidden">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Item</th>
                <th>Category</th>
                <th>Diet</th>
                <th>Price</th>
                <th>Calories</th>
                <th>Rating</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% foods.forEach(item => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-3">
                      <img src="<%= item.image %>" alt="<%= item.name %>" class="rounded-3" style="width: 50px; height: 50px; object-fit: cover;">
                      <div>
                        <strong class="d-block text-dark"><%= item.name %></strong>
                        <small class="text-muted"><%= item.deliveryTime %></small>
                      </div>
                    </div>
                  </td>
                  <td><span class="badge bg-light text-dark border"><%= item.category %></span></td>
                  <td>
                    <% if (item.isVeg) { %>
                      <span class="badge bg-success-subtle text-success">Veg</span>
                    <% } else { %>
                      <span class="badge bg-danger-subtle text-danger">Non-Veg</span>
                    <% } %>
                  </td>
                  <td><strong class="text-dark">₹<%= item.price %></strong></td>
                  <td><small class="text-muted"><%= item.calories %></small></td>
                  <td><span class="text-warning fw-bold">★ <%= item.rating %></span></td>
                  <td class="text-end">
                    <form action="/admin/foods/delete/<%= item.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this food item?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete Item">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Food Modal -->
<div class="modal fade" id="addFoodModal" tabindex="-1" aria-labelledby="addFoodModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="addFoodModalLabel">Add New Food Item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <form action="/admin/foods/add" method="POST">
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label fw-semibold small">Food Name</label>
              <input type="text" name="name" class="form-control" placeholder="e.g. Truffle Mushroom Pizza" required>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold small">Category</label>
              <select name="categoryId" class="form-select">
                <% categories.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold small">Price (₹)</label>
              <input type="number" step="1" name="price" class="form-control" placeholder="299" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold small">Original Price (₹)</label>
              <input type="number" step="1" name="originalPrice" class="form-control" placeholder="349">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold small">Image URL</label>
              <input type="url" name="image" class="form-control" placeholder="https://images.unsplash.com/..." value="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=600">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold small">Dietary Type</label>
              <div class="d-flex gap-3 pt-2">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="dietType" value="veg" id="vegRadio" checked>
                  <label class="form-check-label text-success fw-bold" for="vegRadio">Vegetarian</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="dietType" value="non-veg" id="nonVegRadio">
                  <label class="form-check-label text-danger fw-bold" for="nonVegRadio">Non-Vegetarian</label>
                </div>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold small">Description</label>
              <textarea name="description" class="form-control" rows="3" placeholder="Delicious recipe description..." required></textarea>
            </div>
          </div>
          <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary-custom px-4">Save Food Item</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
