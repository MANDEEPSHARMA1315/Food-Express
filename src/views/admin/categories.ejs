<%- include('../partials/head') %>

<!-- Admin Header -->
<nav class="navbar navbar-dark bg-dark px-3 py-2 border-bottom border-secondary">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/admin">
      <span class="badge bg-danger p-2"><i class="bi bi-shield-lock-fill"></i></span>
      <span>FoodExpress <span class="text-warning">Admin Console</span></span>
    </a>
    <div class="d-flex align-items-center gap-3">
      <a href="/" class="btn btn-outline-light btn-sm rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i> Visit Website</a>
      <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
    </div>
  </div>
</nav>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-lg-2 col-md-3 p-0 admin-sidebar">
      <div class="p-3">
        <h6 class="text-uppercase text-secondary-subtle small fw-bold mb-3">Management</h6>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/orders"><i class="bi bi-bag-check"></i> Customer Orders</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/foods"><i class="bi bi-egg-fried"></i> Food Catalog</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/admin/categories"><i class="bi bi-tags"></i> Food Categories</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="col-lg-10 col-md-9 p-4 bg-light">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h3 fw-bold mb-1">Categories Management</h2>
          <p class="text-muted small mb-0">Organize food dishes into attractive user-friendly categories.</p>
        </div>
      </div>

      <%- include('../partials/alerts') %>

      <div class="row g-4">
        <!-- Categories Table -->
        <div class="col-lg-8">
          <div class="card border rounded-4 shadow-sm overflow-hidden">
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Icon</th>
                    <th>Category Name</th>
                    <th>Slug</th>
                    <th>Items</th>
                  </tr>
                </thead>
                <tbody>
                  <% categories.forEach(cat => { %>
                    <tr>
                      <td>
                        <div class="bg-light rounded-circle p-2 d-inline-flex align-items-center justify-content-center text-primary" style="width: 40px; height: 40px;">
                          <i class="bi <%= cat.icon %> fs-5"></i>
                        </div>
                      </td>
                      <td><strong class="text-dark"><%= cat.name %></strong></td>
                      <td><code><%= cat.slug %></code></td>
                      <td><span class="badge bg-secondary-subtle text-dark"><%= cat.count || 0 %> dishes</span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Add Category Card -->
        <div class="col-lg-4">
          <div class="card border rounded-4 shadow-sm p-4">
            <h5 class="fw-bold mb-3">Add New Category</h5>
            <form action="/admin/categories/add" method="POST">
              <div class="mb-3">
                <label class="form-label fw-semibold small">Category Name</label>
                <input type="text" name="name" class="form-control" placeholder="e.g. Italian Pastas" required>
              </div>
              <div class="mb-3">
                <label class="form-label fw-semibold small">Category Slug</label>
                <input type="text" name="slug" class="form-control" placeholder="e.g. italian-pastas">
              </div>
              <div class="mb-3">
                <label class="form-label fw-semibold small">Bootstrap Icon Class</label>
                <input type="text" name="icon" class="form-control" placeholder="bi-cup-straw" value="bi-egg-fried">
              </div>
              <button type="submit" class="btn btn-primary-custom w-100 justify-content-center">
                <i class="bi bi-plus-lg me-1"></i> Create Category
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
