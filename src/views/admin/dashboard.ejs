<%- include('../partials/head') %>

<!-- Admin Specific Navbar Header -->
<nav class="navbar navbar-dark bg-dark px-3 py-2 border-bottom border-secondary">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/admin">
      <span class="badge bg-danger p-2"><i class="bi bi-shield-lock-fill"></i></span>
      <span>FoodExpress <span class="text-warning">Admin Console</span></span>
    </a>
    <div class="d-flex align-items-center gap-3">
      <a href="/" class="btn btn-outline-light btn-sm rounded-pill px-3">
        <i class="bi bi-box-arrow-up-right me-1"></i> Visit Website
      </a>
      <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">
        <i class="bi bi-box-arrow-right me-1"></i> Logout
      </a>
    </div>
  </div>
</nav>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar Navigation -->
    <div class="col-lg-2 col-md-3 p-0 admin-sidebar">
      <div class="p-3">
        <h6 class="text-uppercase text-secondary-subtle small fw-bold mb-3">Management</h6>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link active" href="/admin">
              <i class="bi bi-speedometer2"></i> Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/orders">
              <i class="bi bi-bag-check"></i> Customer Orders
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/foods">
              <i class="bi bi-egg-fried"></i> Food Catalog
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/categories">
              <i class="bi bi-tags"></i> Food Categories
            </a>
          </li>
        </ul>

        <h6 class="text-uppercase text-secondary-subtle small fw-bold mt-4 mb-3">DevOps & Server</h6>
        <ul class="nav flex-column">
          <li class="nav-item">
            <span class="nav-link text-light opacity-75">
              <i class="bi bi-hdd-network"></i> Node v24 • Docker
            </span>
          </li>
          <li class="nav-item">
            <span class="nav-link text-light opacity-75">
              <i class="bi bi-database-check"></i> MySQL 8.0 Ready
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="col-lg-10 col-md-9 p-4 bg-light">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h3 fw-bold mb-1">Executive Dashboard</h2>
          <p class="text-muted small mb-0">Overview of operational revenue, active orders, and customer activity.</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/admin/foods" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Add Food Item
          </a>
        </div>
      </div>

      <!-- Stat Cards Row -->
      <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
          <div class="admin-stat-card">
            <div class="stat-icon bg-success-subtle text-success">
              <i class="bi bi-currency-rupee"></i>
            </div>
            <div>
              <small class="text-muted text-uppercase fw-bold">Total Sales</small>
              <h3 class="fw-bold mb-0">₹<%= stats.totalRevenue.toLocaleString('en-IN') %></h3>
            </div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6">
          <div class="admin-stat-card">
            <div class="stat-icon bg-primary-subtle text-primary">
              <i class="bi bi-bag-check-fill"></i>
            </div>
            <div>
              <small class="text-muted text-uppercase fw-bold">Total Orders</small>
              <h3 class="fw-bold mb-0"><%= stats.totalOrders %></h3>
            </div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6">
          <div class="admin-stat-card">
            <div class="stat-icon bg-warning-subtle text-warning">
              <i class="bi bi-fire"></i>
            </div>
            <div>
              <small class="text-muted text-uppercase fw-bold">Active Dishes</small>
              <h3 class="fw-bold mb-0"><%= foodsCount %></h3>
            </div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6">
          <div class="admin-stat-card">
            <div class="stat-icon bg-info-subtle text-info">
              <i class="bi bi-people-fill"></i>
            </div>
            <div>
              <small class="text-muted text-uppercase fw-bold">Customers</small>
              <h3 class="fw-bold mb-0"><%= stats.totalCustomers %></h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Orders Table -->
      <div class="card border rounded-4 shadow-sm overflow-hidden mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0">Recent Live Orders</h5>
          <a href="/admin/orders" class="btn btn-sm btn-outline-secondary rounded-pill">View All Orders</a>
        </div>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Ordered Items</th>
                <th>Total</th>
                <th>Status</th>
                <th>Time</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% stats.recentOrders.forEach(order => { %>
                <tr>
                  <td><strong class="text-dark">#<%= order.id %></strong></td>
                  <td><%= order.customer %></td>
                  <td><small class="text-muted"><%= order.items %></small></td>
                  <td><strong>₹<%= order.total %></strong></td>
                  <td>
                    <% 
                      let statusBadge = 'secondary';
                      if (order.status === 'Delivered') statusBadge = 'success';
                      else if (order.status === 'Out for Delivery') statusBadge = 'primary';
                      else if (order.status === 'Preparing') statusBadge = 'warning';
                      else if (order.status === 'Confirmed') statusBadge = 'info';
                    %>
                    <span class="badge bg-<%= statusBadge %>-subtle text-<%= statusBadge %> rounded-pill px-3 py-1">
                      <%= order.status %>
                    </span>
                  </td>
                  <td><small class="text-muted"><%= order.date %></small></td>
                  <td class="text-end">
                    <a href="/orders/track/<%= order.id %>" class="btn btn-sm btn-light border rounded-pill px-2" title="Inspect Order">
                      <i class="bi bi-eye"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
