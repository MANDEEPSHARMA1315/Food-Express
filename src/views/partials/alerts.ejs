<% if (typeof successMessage !== 'undefined' && successMessage) { %>
  <div class="alert alert-success alert-dismissible fade show alert-auto-dismiss rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert" id="alertSuccess">
    <i class="bi bi-check-circle-fill fs-5"></i>
    <div><%= successMessage %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
  <div class="alert alert-danger alert-dismissible fade show alert-auto-dismiss rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert" id="alertError">
    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
    <div><%= errorMessage %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
