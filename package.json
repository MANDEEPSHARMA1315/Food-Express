{
  "name": "food-express",
  "version": "1.0.0",
  "description": "Online Food Ordering and Management System with Docker & DevOps",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "seed": "node src/config/seed.js"
  },
  "keywords": [
    "food-delivery",
    "express",
    "mysql",
    "docker",
    "devops",
    "jenkins",
    "bootstrap5",
    "ejs",
    "jest"
  ],
  "author": "MCA Portfolio Developer",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
